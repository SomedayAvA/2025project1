<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<buildspec version="4.0">
    <dir path="." type="custom"/>
    <dir makemake-options="--make-so --deep -o veins -O out -pVEINS -I/usr/local/include/SEAL-4.1 -I/usr/local/include/openfhe/binfhe -I/usr/local/include/openfhe/pke -I/usr/local/include/openfhe/core -I/usr/local/include/openfhe -I/usr/lib/x86_64-linux-gnu -I/usr/include/openssl -I/usr/local/lib -lseal-4.1 -lOPENFHEbinfhe -lOPENFHEpke -lOPENFHEcore -lprotobuf -lcrypto -lgmp -lgmpxx -lhcs --meta:export-include-path --meta:export-library --meta:use-exported-libs --meta:feature-cflags --meta:feature-ldflags" path="src" type="makemake"/>
</buildspec>
